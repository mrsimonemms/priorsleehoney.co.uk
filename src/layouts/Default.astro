---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Hero, { type Props as HeroProps } from '../components/Hero.astro';
import Navbar from '../components/Navbar.astro';

interface Props {
  title?: string;
  description?: string;
  img?: string;
  heroSize?: HeroProps['size'];
}

const {
  title = 'Unknown',
  description = 'Unknown',
  img = '/img/photos/simon.jpg',
  heroSize = 'large',
} = Astro.props;
---

<!doctype html>
<html>
  <head>
    <BaseHead title={title} description={description} />

    <!-- Google Tag Manager -->
    <script lang="js">
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-N2VQH3TL');
    </script>
    <!-- End Google Tag Manager -->
  </head>
  <body class="is-flex is-flex-direction-column" style="min-height: 100vh">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-N2VQH3TL"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <Navbar />

    <div class="is-flex-grow-1">
      <Hero img={img} size={heroSize}>
        <div
          class="is-align-items-center has-background-black-ter is-inline-block p-5"
        >
          <h1 class="title has-text-white-ter">{description}</h1>
        </div>
      </Hero>

      <div class="my-6">
        <slot />
      </div>
    </div>

    <Footer />
  </body>
</html>
